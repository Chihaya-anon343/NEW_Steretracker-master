@startuml
skinparam style strictuml
skinparam DefaultFontName Arial
skinparam StateBackgroundColor #F9F9F9
skinparam StateBorderColor #333333
skinparam ArrowColor #0066CC
skinparam NoteBackgroundColor #FEFECE

title 图3-2: 退化后备链全景与跨状态转移状态机图

state "初始状态判定\n(基于目标投影面积)" as InitialState

state "State 4: 近距离 (独立路径)" as State4 {
    state "Dual-ROI 混合特征提取" as DualROI
    DualROI : - class 0 区域: 二值角点提取
    DualROI : - class 1 区域: AKAZE描述子匹配
}

state "State 1-3: 主退化链 (无环、单向)" as MainChain {
    state "AKAZE 描述子策略\n(中近距主策略)" as Akaze
    state "二值角点提取策略\n(中距主策略)" as Binary
    state "超分辨率微目标策略\n(远距主策略)" as SuperRes

    Akaze -[#red]-> Binary : 提取/校验失败 (触发降级)
    Binary -[#red]-> SuperRes : 提取/校验失败 (触发降级)
}

state "State 5: 极近距离 (CloseRange回退)" as State5 {
    state "重置 ROI (仅限 class 1)" as ReROI
    state "面积重计算与状态重分类" as Reclassify
    ReROI --> Reclassify
}

state "特征提取与匹配成功" as Success
state "当前帧跟踪失败" as Failure

[*] --> InitialState

InitialState --> Akaze : 判定为 State 3
InitialState --> Binary : 判定为 State 2
InitialState --> SuperRes : 判定为 State 1
InitialState --> State4 : 判定为 State 4
InitialState --> State5 : 触发 State 5\n(class 0 丢失)

note top of MainChain: 沿信息维度递减、鲁棒性递增方向降级

Akaze -[#green]-> Success : 成功
Binary -[#green]-> Success : 成功
SuperRes -[#green]-> Success : 成功
SuperRes -[#red]-> Failure : 退化链耗尽

State4 -[#green]-> Success : 双分支均成功
State4 -[#red]-> Failure : 任一支路失败\n(不参与退化链)

Reclassify --> InitialState : 重新进入判定逻辑

Success --> [*]
Failure --> [*]

@enduml
