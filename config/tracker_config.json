{
  "mode": "debug",

  "_comment_normal": "═════ Normal 模式 (mode=normal) — InputProvider ═════",
  "input_system": {
    "_comment": "type: file / directory / sequence",
    "max_frames": 0,
    "image": {
      "type": "directory",
      "left_path": "",
      "right_path": "",
      "directory_path": "data/stere_frames",
      "left_pattern": "left",
      "right_pattern": "right",
      "sequence_pattern": "frame"
    },
    "imu": {
      "_comment": "Phase 2, Linux only",
      "enabled": false,
      "port": "/dev/ttyUSB0",
      "baud_rate": 921600,
      "protocol": "custom"
    },
    "altimeter": {
      "_comment": "Phase 2, Linux only",
      "enabled": false,
      "can_interface": "can0",
      "type": "can"
    }
  },

  "_comment_debug": "═════ Debug 模式 (mode=debug) — cv::imread ═════",
  "input": {
    "_comment": "Debug 模式图像路径",
    "left": "data/big/cj01_image_0032 - 副本.jpg",
    "right": "data/big/cj01_image_0032.jpg"
  },

  "manual_roi": {
    "_comment": "enabled=true 跳过 YOLO (仅 debug 模式生效)",
    "enabled": false,
    "left":  { "x": 416, "y": 113, "width": 300, "height": 300 },
    "right": { "x": 410, "y": 113, "width": 300, "height": 300 }
  },

  "_comment_common": "═════ 公用参数（Normal / Debug 均生效）═════",
  "_comment_mono": "true=单目(MonoTracker+EPnP)  false=双目(StereoTracker+GPNP)",
  "mono_mode": false,

  "output": {
    "_comment_visualize": "是否保存可视化图像 (Normal=三维轴图  Debug=完整面板)",
    "visualize": true,
    "log_file": true
  },

  "camera": {
    "fx": 541.764,
    "fy": 541.764,
    "cx": 553.682,
    "cy": 232.397,
    "baseline_mm": 60.0
  },

  "yolo": {
    "model_path": "yolo_onnx/yolov8n.onnx",
    "conf_threshold": 0.5,
    "target_class_id": 0,
    "roi_expand_ratio": 0.0,
    "roi_min_size": 0
  },

  "strategies": {
    "_comment": "ROI area thresholds: <= tiny_max -> TinyTarget, >= akaze_min -> AKAZE, else BinaryCorner",
    "akaze_min_area": 40001,
    "tiny_max_area": 400,
    "dual_trigger_area": 490000,
    "stereo_mono_fallback": false,

    "close_range": {
      "_comment": "近距离回退: class0 未检测到 + class1 有效时触发",
      "enabled": true,
      "class1_min_area": 100,
      "roi_expand_ratio": 1,
      "min_expand_pixels": 1,
      "akaze_min_area": 4000000,
      "tiny_max_area": 400
    },

    "akaze_gpnp": {
      "template_path": "data/big/img_1.png",
      "template_real_width_mm": 500.0,
      "template_real_height_mm": 500.0,
      "scale": 0.5,
      "gpnp_min_pts": 4,
      "use_initial_pnp": true
    },

    "binary_corner": {
      "template_dir": "data/NewMuBan(reordered)",
      "corners": 10,
      "kernel_size": 3,
      "corner_scale": 3.0,
      "target_width": 100,
      "target_height": 100,
      "pixel_to_meter_scale_class0": 0.004,
      "pixel_to_meter_scale_class1": 0.0004,
      "roi_pad_pixels": 3,
      "otsu_ratio": 1
    },

    "tiny_target": {
      "template_dir": "data/NewMuBan(reordered)",
      "target_width": 50,
      "target_height": 50,
      "scale_factor": 4,
      "square_size_m_class0": 0.2,
      "square_size_m_class1": 0.04,
      "roi_pad_pixels": 5
    },

    "dual_roi": {
      "_comment": "双ROI class1 拓展像素 + AKAZE scale",
      "secondary_expand_pixels": 50,
      "akaze": {
        "scale": 1
      }
    }
  }
}
