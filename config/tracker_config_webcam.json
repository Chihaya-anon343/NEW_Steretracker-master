{
  "mode": "normal",

  "_comment": "═════ 实时 webcam 模式: input_system.image.type=camera + mono_mode=true (单摄像头) ═════",
  "input_system": {
    "_comment": "type: file / directory / sequence / camera",
    "max_frames": 0,
    "use_threaded_capture": true,
    "_comment_thread": "Phase 3.1: 采集线程+环形缓冲 (take-latest)。Camera 类型默认自动启用, 此配置可省略; ring_capacity 越小延迟越低, 越大抗处理耗时尖峰",
    "ring_capacity": 4,
    "image": {
      "type": "camera",
      "left_path": "",
      "right_path": "",
      "directory_path": "",
      "left_pattern": "left",
      "right_pattern": "right",
      "sequence_pattern": "frame",
      "camera_devices": "0",
      "target_fps": 10
    },
    "imu": {
      "_comment": "Phase 2, Linux only",
      "enabled": false,
      "port": "/dev/ttyUSB0",
      "baud_rate": 921600,
      "protocol": "custom"
    },
    "altimeter": {
      "_comment": "Phase 2, Linux only",
      "enabled": false,
      "can_interface": "can0",
      "type": "can"
    }
  },

  "_comment_debug": "═════ Debug 模式 (debug 模式才需要; 实时模式不使用) ═════",
  "input": {
    "left": "",
    "right": ""
  },

  "manual_roi": {
    "enabled": false,
    "left":  { "x": 416, "y": 113, "width": 300, "height": 300 },
    "right": { "x": 410, "y": 113, "width": 300, "height": 300 }
  },

  "_comment_common": "═════ 公用参数（Normal / Debug 均生效）═════",
  "_comment_mono": "true=单目(MonoTracker+EPnP)  单摄像头必须 true",
  "mono_mode": true,

  "output": {
    "_comment_visualize": "false: 实时运行不落盘可视化图",
    "_comment_log": "Phase 3.2: 优雅退出已实现 — Ctrl+C 后帧循环收尾, 日志可正常落盘到 output/sequence/tracking_log.txt; 终端逐帧结果不受影响",
    "visualize": false,
    "log_file": true
  },

  "camera": {
    "_comment_calib": "⚠️ 占位内参 (按 640x480 假设), 必须用棋盘格标定后替换 fx/fy/cx/cy; baseline 单目用不到",
    "fx": 800.0,
    "fy": 800.0,
    "cx": 320.0,
    "cy": 240.0,
    "baseline_mm": 60.0
  },

  "yolo": {
    "model_path": "best.onnx",
    "conf_threshold": 0.5,
    "target_class_id": 0,
    "roi_expand_ratio": 0.0,
    "roi_min_size": 0
  },

  "strategies": {
    "_comment": "ROI area thresholds: <= tiny_max -> TinyTarget, >= akaze_min -> AKAZE, else BinaryCorner",
    "akaze_min_area": 40001,
    "tiny_max_area": 400,
    "dual_trigger_area": 490000,
    "stereo_mono_fallback": false,

    "close_range": {
      "_comment": "近距离回退: class0 未检测到 + class1 有效时触发",
      "enabled": true,
      "class1_min_area": 100,
      "roi_expand_ratio": 1,
      "min_expand_pixels": 1,
      "akaze_min_area": 4000000,
      "tiny_max_area": 400
    },

    "akaze_gpnp": {
      "template_path": "data/big/img_1.png",
      "template_real_width_mm": 500.0,
      "template_real_height_mm": 500.0,
      "scale": 0.5,
      "gpnp_min_pts": 4,
      "use_initial_pnp": true
    },

    "binary_corner": {
      "template_dir": "data/NewMuBan(reordered)",
      "corners": 10,
      "kernel_size": 3,
      "corner_scale": 3.0,
      "target_width": 100,
      "target_height": 100,
      "pixel_to_meter_scale_class0": 0.004,
      "pixel_to_meter_scale_class1": 0.0004,
      "roi_pad_pixels": 3,
      "otsu_ratio": 1
    },

    "tiny_target": {
      "template_dir": "data/NewMuBan(reordered)",
      "target_width": 50,
      "target_height": 50,
      "scale_factor": 4,
      "square_size_m_class0": 0.2,
      "square_size_m_class1": 0.04,
      "roi_pad_pixels": 5
    },

    "dual_roi": {
      "_comment": "双ROI class1 拓展像素 + AKAZE scale",
      "secondary_expand_pixels": 50,
      "akaze": {
        "scale": 1
      }
    }
  }
}
